# Copier ce fichier en .env et remplir les valeurs
# .env est dans .gitignore — ne jamais committer les clés

# Clé API Anthropic (obligatoire pour le scoring Claude)
# Obtenir sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Token GitHub (optionnel — passe de 60 à 5000 requêtes/heure)
# GITHUB_TOKEN=ghp_...
